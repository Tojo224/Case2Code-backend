package {{ package_name }}.repository;

import {{ package_name }}.domain.{{ entity.name }};
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface {{ entity.name }}Repository extends JpaRepository<{{ entity.name }}, {{ entity.id_type }}> {
{% for rel in entity.relationships %}
{% if not rel.is_collection and rel.jpa_annotation == "@ManyToOne" %}
    List<{{ entity.name }}> findBy{{ rel.field_name[0]|upper ~ rel.field_name[1:] }}Id({{ rel.id_type }} {{ rel.field_name }}Id);
{% endif %}
{% endfor %}
}
