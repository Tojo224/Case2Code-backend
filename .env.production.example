# Copy to `.env` next to docker-compose.prod.yml and fill in. NEVER commit the real .env.

# --- required -----------------------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 24   (hex only: the value is embedded in a URL)
POSTGRES_PASSWORD=

# --- database (defaults are fine) -------------------------------------------------------------
POSTGRES_USER=case2code
POSTGRES_DB=case2code_db

# --- AI ---------------------------------------------------------------------------------------
# local | hybrid | gemini. Without Ollama (profile) and without a Gemini key the assistant
# falls back to the built-in rule engine.
AI_PROVIDER_MODE=hybrid
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Only used with `--profile ollama`:
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=qwen2.5-coder:3b

# --- network ----------------------------------------------------------------------------------
# Leave empty to serve plain HTTP on port 80 (works on the bare EC2 public IP).
# Set your domain to switch nginx to HTTPS (see DEPLOY.md, "HTTPS").
TLS_DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443
# Same-origin by default, so NO cross-origin access. Only set this if another origin calls the API.
CORS_ALLOWED_ORIGINS=
