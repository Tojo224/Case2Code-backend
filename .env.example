# ==============================================================================
# Case2Code Backend Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="Case2Code CASE Platform"
API_V1_STR="/api"

# Primary Database (PostgreSQL via Docker Compose: docker compose up -d)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/case2code_db

# Fallback Database (Auto-selected if PostgreSQL is offline or unreachable)
SQLITE_FALLBACK_URL=sqlite:///./case2code.db

# Google Gemini AI Studio API Key (Optional)
# If provided: Enables Gemini 2.0 Flash for CASE Diagram Assistant & Generated Business Assistant
# If empty: Falls back automatically to the offline deterministic rule-based engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
